# This project does not auto-load .env files.
# Export these variables in your shell or configure them in Render.

# Required for any local app start
DATABASE_URL=sqlite:///./local_dev.sqlite3
AUTH_SECRET_KEY=replace-with-a-long-random-secret

# Strongly recommended when the frontend runs separately
FRONTEND_BASE_URL=http://localhost:5173
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for real grading calls (default provider: doubao/ARK)
# ARK_API_KEY=replace-with-a-real-ark-key

# Required for real grading calls only when GRADING_PROVIDER=qwen (fallback provider)
# DASHSCOPE_API_KEY=replace-with-a-real-dashscope-key

# Optional runtime tuning
# APP_DATA_DIR=/absolute/path/to/runtime-data
# GRADING_PROVIDER=doubao  # doubao (default) or qwen
# GRADING_BATCH_CONCURRENCY=4  # 批量批改的并发数，受方舟账号限流额度约束，按需调整
# DOUBAO_VISION_MODEL=doubao-seed-2-1-turbo-260628
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# TEACHER_SIGNUP_CODE=  # unset = teacher signup invite-code gate disabled

# Qwen-fallback-only tuning (only relevant when GRADING_PROVIDER=qwen)
# QWEN_VISION_MODEL=qwen-vl-max-latest
# QWEN_PLUS_MODEL=qwen3.5-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ACCESS_TOKEN_EXPIRE_MINUTES=720
# AUTH_ALGORITHM=HS256
# PASSWORD_HASH_ITERATIONS=260000
# SQLALCHEMY_ECHO=false

# Local-only helpers
# HOST=127.0.0.1
# PORT=8000
# UVICORN_RELOAD=false
# RUN_EXTERNAL_SMOKE=false
